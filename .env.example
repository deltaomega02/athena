# ATHENA 환경변수 (.env로 복사 후 작성)

# === Bybit ===
BYBIT_API_KEY=
BYBIT_SECRET=
BYBIT_USE_TESTNET=true   # Phase 0/1: true (Testnet)
                          # Phase 2+: false (Mainnet)

# === Gemini ===
GEMINI_API_KEY=          # https://aistudio.google.com/apikey

# === Coinalyze (선택, 없어도 작동) ===
COINALYZE_API_KEY=

# === Telegram (ATHENA 전용 봇 — HERMES와 별개) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === 모드 ===
PAPER_MODE=true          # Phase 0/1: true (실제 주문 X)
                          # Phase 2+: false (실전)
