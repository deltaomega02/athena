[Unit]
Description=ATHENA AI Portfolio Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/home/botuser/ATHENA
Environment="PATH=/home/botuser/ATHENA/athena/bin:/usr/bin:/bin"
ExecStart=/home/botuser/ATHENA/athena/bin/python3 -u /home/botuser/ATHENA/main.py

# 자동 재시작: 죽으면 10초 후 재시작
Restart=always
RestartSec=10

# 로그 — journalctl로 통합 관리
StandardOutput=append:/home/botuser/ATHENA/output.log
StandardError=append:/home/botuser/ATHENA/output.log

# 메모리 제한 (안전망 — 폭증 시 OOM)
MemoryMax=1G

# 1분에 5번 이상 죽으면 일시 정지 (무한 재시작 방지)
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
